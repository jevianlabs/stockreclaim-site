---
import { site } from "../site.config";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="brand-lockup" href="/" aria-label="StockReclaim home">
          <svg viewBox="28 30 104 100" aria-hidden="true">
            <rect x="30" y="122" width="100" height="6" fill="#F4F7F5"/>
            <rect x="40" y="35" width="32" height="82" fill="#F4F7F5"/>
            <rect x="88" y="70" width="32" height="47" fill="#F4F7F5"/>
            <rect x="88" y="35" width="32" height="30" fill="#E4B54D"/>
          </svg>
          <span class="wordmark"><b>Stock</b><span>Reclaim</span></span>
        </a>
        <p class="muted" style="margin-top:16px; max-width:34ch;">
          We audit returns, we don't manage them. Find refunded and returned
          items that never made it back to sellable stock.
        </p>
      </div>

      <div>
        <h4>Product</h4>
        <ul>
          <li><a href="/pricing/">Pricing</a></li>
          <li><a href="/changelog/">What's new</a></li>
          <li><a href="/feature-requests/">Feature requests</a></li>
          <li><a href="/help/">Help center</a></li>
        </ul>
      </div>

      <div>
        <h4>Support</h4>
        <ul>
          <li><a href="/support/">Contact support</a></li>
          <li><a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a></li>
          <li><a href="/help/data-and-privacy/">Data &amp; privacy</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-legal">
      <span>© {year} StockReclaim · JevianLabs</span>
      <span>Built for Shopify merchants. Not affiliated with Shopify Inc.</span>
    </div>
  </div>
</footer>
