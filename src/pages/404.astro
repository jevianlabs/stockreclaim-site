---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="That page didn't make it back to the shelf." noindex>
  <section class="on-teal" style="min-height:52vh; display:flex; align-items:center;">
    <div class="wrap narrow" style="text-align:center;">
      <p class="figure num" style="font-size:3rem; margin:0;">404</p>
      <h1 style="margin-top:8px;">That page didn't make it back to the shelf.</h1>
      <p class="muted" style="font-size:1.1rem;">Fitting, given what we do. Let's get you back.</p>
      <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap; margin-top:20px;">
        <a class="btn btn-on-teal" href="/">Home</a>
        <a class="btn btn-ghost-on-teal" href="/help/">Help center</a>
      </div>
    </div>
  </section>
</Base>
